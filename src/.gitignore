node_modules
scripts/.build-state.json
**/public/env.js
.dev-relay-content/
hypercomb-relay/blossom-worker/.wrangler/

# relay ops diagnostics (local transcripts + staged dev content)
hypercomb-relay/fix-result.txt
hypercomb-relay/add-writer-result.txt
hypercomb-relay/dev-content/
__webgl2-probe-test.html

# Revolución site preview build (npm run revolucion:preview)
site-preview/

# Rust build output (cargo). Thousands of fingerprint files per profile, all
# reproducible from the sources — never committed.
hypercomb-client/target/

# The client's baked frontend: a copy of the web build, produced by
# `node hypercomb-client/scripts/bake-frontend.mjs`. The SCRIPT is the source;
# its ~800-file output is not, and committing it would duplicate every web
# asset (content, substrate, documentation) inside the client.
hypercomb-client/app/frontend/

# The client's staged HOST SHELL: a copy of hypercomb-shim/dist, produced by
# `node hypercomb-client/scripts/stage-host-shell.mjs`, bundled as a Tauri
# resource and served to visitors by Hive > Serve This Hive. Same reasoning as
# the frontend below — the script is the source, the 24MB of build output is
# not. The README is kept so the bundler's resource glob always matches.
hypercomb-client/app/host-shell/*
!hypercomb-client/app/host-shell/README.md

# Baked client frontend — a fresh copy of hypercomb-web/dist with a static
# import map written into index.html, produced by
# `node hypercomb-client/scripts/bake-frontend.mjs` (which rm -rf's it first).
# 72MB, including the bundled content payload; the web shell's equivalent
# (hypercomb-web/public/content) has always been ignored for the same reason.
hypercomb-client/app/frontend/
.claude/skill-library/
