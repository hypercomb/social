{
  "name": "hypercomb-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prestart": "npm --prefix .. run prebuild:web",
    "start": "node ./scripts/serve.mjs --port 4250 --host localhost",
    "start:4260": "node ./scripts/serve.mjs --port 4260 --host localhost",
    "build": "npm --prefix .. run prebuild:web && node ./scripts/build.mjs",
    "postbuild": "node ../hypercomb-client/scripts/bake-frontend.mjs --if-available",
    "runtime": "npm run runtime:core && npm run runtime:pixi",
    "runtime:core": "node ./scripts/build-core-vendor.cjs",
    "runtime:pixi": "tsx ./scripts/build-pixi-vendor.ts"
  },
  "overrides": {
    "undici": "7.24.1"
  },
  "dependencies": {
    "@hypercomb/core": "file:../hypercomb-core"
  },
  "devDependencies": {
    "esbuild": "^0.27.0",
    "pixi.js": "^8.16.0",
    "sass": "^1.97.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3"
  }
}
