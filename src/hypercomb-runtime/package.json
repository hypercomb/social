{
  "name": "@hypercomb/runtime",
  "version": "0.1.0",
  "description": "The Hypercomb runtime: OPFS store, module graph, replication protocol, and boot. Everything a host needs and nothing a shell does.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hypercomb/core": "file:../hypercomb-core"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "~5.9.3"
  },
  "license": "AGPL-3.0-only",
  "private": true
}
