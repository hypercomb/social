{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "hypercomb-dev": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "targets": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/hypercomb-dev",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["@hypercomb/shared/core/ioc.web"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "../shared-public"
              },
              {
                "glob": "**/*",
                "input": "../hypercomb-shared/tracks",
                "output": "/tracks"
              },
              {
                "glob": "**/*.md",
                "input": "../documentation",
                "output": "/documentation"
              }
            ],
            "styles": [
              "src/styles.scss"
            ],
            "allowedCommonJsDependencies": [
              "@xmldom/xmldom",
              "parse-svg-path",
              "@hypercomb/shared/core/ioc.web"
            ]
          },
          "configurations": {
            "production": {
              "sourceMap": true,
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4.2mb",
                  "maximumError": "4.5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "32kB",
                  "maximumError": "48kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": {
                "scripts": true,
                "styles": false,
                "vendor": false,
                "hidden": false,
                "sourcesContent": true
              }
            },
            "deploy": {
              "browser": "src/main.deploy.ts",
              "index": {
                "input": "../hypercomb-web/src/index.html",
                "output": "index.html"
              },
              "assets": [
                {
                  "glob": "**/*",
                  "input": "../hypercomb-web/public"
                },
                {
                  "glob": "**/*",
                  "input": "../shared-public"
                },
                {
                  "glob": "**/*",
                  "input": "../hypercomb-shared/tracks",
                  "output": "/tracks"
                },
                {
                  "glob": "**/*.md",
                  "input": "../documentation",
                  "output": "/documentation"
                }
              ],
              "styles": [
                "../hypercomb-web/src/styles.scss",
                "@angular/material/prebuilt-themes/deeppurple-amber.css"
              ],
              "tsConfig": "tsconfig.deploy.json",
              "sourceMap": false,
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.8MB",
                  "maximumError": "2.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "32kB",
                  "maximumError": "48kB"
                }
              ]
            }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4200,
            "open": false,
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "development": {
              "buildTarget": "hypercomb-dev:build:development"
            },
            "production": {
              "buildTarget": "hypercomb-dev:build:production"
            },
            "deploy": {
              "buildTarget": "hypercomb-dev:build:deploy"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  }
}
