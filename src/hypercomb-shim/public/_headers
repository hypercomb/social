# Static-asset headers for the shim harness (Cloudflare Pages / any host that
# reads _headers). The shim serves three kinds of thing and they cache
# differently:
#
#   /<sig>, /content/<sig>  — content-addressed. The name IS the hash, so the
#                             bytes behind it never change.
#   /vendor, /core          — built, replaced under a fixed name. Cache, but
#                             keep a revalidation path.
#   the worker + env.js     — the only code channel left. A stale service
#                             worker strands a client on an old runtime with
#                             no way back, so it must never cache hard.

# REPLICATION REQUIRES CORS. A host exists to be pulled FROM — by nodes on
# other origins, which is the whole point of a replicated network. Without an
# Access-Control-Allow-Origin header every cross-origin replication dies as an
# opaque "Failed to fetch" with no status and no diagnosis, and the host looks
# to the node exactly like a host that publishes nothing.
#
# `*` is correct and not a compromise: every byte served here is public,
# immutable, content-addressed, and sha256-verified by the reader before it is
# admitted. There is no credential, no session, and no request whose ORIGIN
# changes the answer — so there is nothing for an origin check to protect.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Access-Control-Allow-Origin: *

# Mutable indexes must never inherit an immutable /content/* rule. Pages
# combines overlapping _headers entries, so a broad immutable rule can freeze
# a manifest even when a narrower no-store rule follows it.
/content/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate
/content/44150aa24d2f2a1c1b544530e2f7e177cde71130f882f37984d0cdba16bf2363/*
  Cache-Control: no-cache, no-store, must-revalidate

# THE PAGE LEAVES AS WRITTEN. With Web Analytics on a zone, Cloudflare injects
# its beacon (static.cloudflareinsights.com) into every HTML answer it proxies
# — a third-party script no page here asked for. `no-transform` is the
# directive the edge honours (documented: such a Cache-Control is left alone),
# so the document carries it whatever the account's analytics switch says.
# Pages' own default for HTML is the rest of the value.
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/index.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/*.html
  Cache-Control: public, max-age=0, must-revalidate, no-transform

/vendor/*
  Cache-Control: public, max-age=0, must-revalidate
/core/*
  Cache-Control: public, max-age=0, must-revalidate

/hypercomb.worker.js
  Cache-Control: public, max-age=0, must-revalidate
/env.js
  Cache-Control: public, max-age=0, must-revalidate
/main.js
  Cache-Control: public, max-age=0, must-revalidate
